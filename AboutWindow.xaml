<Window x:Class="SocRcManager.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocRcManager.Localization"
        Title="{loc:T AboutTitle}"
        Width="560" Height="720"
        MinWidth="460" MinHeight="520"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackground}">

    <!--
        «Acerca de» con la estructura canonica del catalogo (constitucion de Mobile 7 y Anexo E):
        cabecera con logo, version y descripcion; contacto; idioma; privacidad; licencia; y el
        aviso legal, que va el ultimo. Las mismas tarjetas y las mismas palabras que en Task
        Manager para Windows y que en las aplicaciones Android.
    -->

    <DockPanel Margin="16">

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource IconButton}"
                    Content="&#xE711;" HorizontalAlignment="Right"
                    ToolTip="{loc:T Close}" Click="OnCloseClick" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0">

                <!-- Cabecera -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="24,22">
                    <StackPanel>
                        <Image x:Name="LogoImage" Width="84" Height="84" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:T AppTitle}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Primary}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock x:Name="VersionLabel" Style="{StaticResource HintText}"
                                   FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:T AboutDescription}" Style="{StaticResource HintText}"
                                   TextAlignment="Center" Margin="0,10,0,0" />
                        <TextBlock Text="{loc:T Publisher}" Style="{StaticResource HintText}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Contacto -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Contact}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Button x:Name="ContactButton" Style="{StaticResource OutlineButton}"
                                Content="{loc:T WriteAuthor}" HorizontalAlignment="Center" Click="OnContactClick" />
                        <TextBlock Text="{loc:T ContactHint}" Style="{StaticResource HintText}"
                                   TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Idioma -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T LanguageTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="SpanishButton" Content="Español"
                                    Style="{StaticResource OutlineButton}" Click="OnSpanishClick" />
                            <Button Grid.Column="2" x:Name="EnglishButton" Content="English"
                                    Style="{StaticResource OutlineButton}" Click="OnEnglishClick" />
                        </Grid>
                        <TextBlock Text="{loc:T LanguageHint}" Style="{StaticResource HintText}"
                                   TextAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Privacidad -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T Privacy}" Style="{StaticResource CardTitle}"
                                   Foreground="{DynamicResource Success}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T PrivacyText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- Licencia -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T License}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:T LicenseText}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock Text="{loc:T LicenseLine}" Style="{StaticResource HintText}"
                                   FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- Aviso legal: obligatorio y el ultimo. -->
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <StackPanel>
                        <TextBlock Text="{loc:T LegalTitle}" Style="{StaticResource CardTitle}"
                                   Foreground="{DynamicResource Danger}" Margin="0,0,0,10" />
                        <Border Background="{DynamicResource WarningSurface}" CornerRadius="8" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{loc:T LegalText1}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="{loc:T LegalText2}" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,0" />
                                <Border Background="{DynamicResource Danger}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                                    <TextBlock Text="{loc:T WarningText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="White" TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
