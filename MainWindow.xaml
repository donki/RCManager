<Window x:Class="SocRcManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SocRcManager.Localization"
        Title="{loc:T AppTitle}"
        Width="1280" Height="800" MinWidth="820" MinHeight="520"
        Background="{DynamicResource PageBackground}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Arbol ============================ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource CardBackground}">
            <DockPanel>
                <!-- Solo iconos (constitucion 6); el nombre de cada uno va en el tooltip. -->
                <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                    <Button x:Name="NewConnectionButton" Style="{StaticResource IconButton}" Content="&#xE710;"
                            ToolTip="{loc:T NewConnectionTooltip}" Click="OnNewConnectionClick" />
                    <Button x:Name="NewFolderButton" Style="{StaticResource GhostIconButton}" Content="&#xE8F4;"
                            ToolTip="{loc:T NewFolderTooltip}" Click="OnNewFolderClick" />
                    <Button x:Name="EditButton" Style="{StaticResource GhostIconButton}" Content="&#xE70F;"
                            ToolTip="{loc:T EditTooltip}" Click="OnEditClick" />
                    <Button x:Name="DuplicateButton" Style="{StaticResource GhostIconButton}" Content="&#xE8C8;"
                            ToolTip="{loc:T DuplicateTooltip}" Click="OnDuplicateClick" />
                    <Button x:Name="DeleteButton" Style="{StaticResource DangerIconButton}" Content="&#xE74D;"
                            ToolTip="{loc:T DeleteTooltip}" Click="OnDeleteClick" />
                    <!-- Importar desde Remote Desktop Manager (.rdm), con su arbol de carpetas. -->
                    <Button x:Name="ImportButton" Style="{StaticResource GhostIconButton}" Content="&#xE8B5;"
                            ToolTip="{loc:T ImportTooltip}" Click="OnImportClick" />
                </WrapPanel>

                <Grid DockPanel.Dock="Top" Margin="10,2,10,6">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Field}" TextChanged="OnSearchChanged" />
                    <TextBlock x:Name="SearchHint" Text="{loc:T SearchHint}" Style="{StaticResource HintText}"
                               Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>

                <Grid DockPanel.Dock="Bottom" Margin="8,4,8,8">
                    <Button x:Name="ConnectButton" Style="{StaticResource IconButton}" Content="&#xE8AF;"
                            ToolTip="{loc:T ConnectTooltip}" Click="OnConnectClick" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostIconButton}" Content="&#xE713;"
                                ToolTip="{loc:T SettingsTooltip}" Click="OnSettingsClick" />
                        <Button x:Name="OpenFileButton" Style="{StaticResource GhostIconButton}" Content="&#xE8B7;"
                                ToolTip="{loc:T OpenFileTooltip}" Click="OnOpenFileClick" />
                        <Button x:Name="LanguageButton" Style="{StaticResource GhostIconButton}" Content="&#xE8C1;"
                                ToolTip="{loc:T LanguageTooltip}" Click="OnLanguageClick" />
                        <Button x:Name="AboutButton" Style="{StaticResource GhostIconButton}" Content="&#xE946;"
                                ToolTip="{loc:T AboutTooltip}" Click="OnAboutClick" />
                    </StackPanel>
                </Grid>

                <Grid>
                    <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="4"
                              ItemContainerStyle="{StaticResource TreeItem}"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              MouseDoubleClick="OnTreeDoubleClick" KeyDown="OnTreeKeyDown" />
                    <TextBlock x:Name="EmptyTree" Text="{loc:T EmptyTree}" Style="{StaticResource HintText}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="24" VerticalAlignment="Center" />
                </Grid>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Row="0" Grid.Column="1" Width="4" Background="{DynamicResource Separator}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!-- ============================ Pestañas ============================ -->
        <Grid Grid.Row="0" Grid.Column="2">
            <TabControl x:Name="Tabs" Background="{DynamicResource MirrorBackground}" BorderThickness="0"
                        Padding="0" SelectionChanged="OnTabChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource SessionTab}" />
                </TabControl.Resources>
            </TabControl>
            <TextBlock x:Name="EmptyTabs" Text="{loc:T EmptyTabs}" Style="{StaticResource HintText}"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- ============================ Estado ============================ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource CardBackground}" Padding="10,4">
            <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
