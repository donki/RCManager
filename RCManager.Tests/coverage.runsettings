<?xml version="1.0" encoding="utf-8"?>
<!--
  Cobertura de la aplicacion (sOCRCManager.dll, referenciada por las pruebas). Sin excluir
  CompilerGeneratedAttribute: los metodos async y las lambdas cuentan. Solo se quita lo generado
  (GeneratedCodeAttribute: el InitializeComponent de las XAML) y lo que vive en obj/.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[sOCRCManager]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
