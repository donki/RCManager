<UserControl x:Class="SocRcManager.Files.FilePane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SocRcManager.Localization"
             Background="{DynamicResource CardBackground}">
    <DockPanel>
        <!-- Cabecera: donde estamos y los botones (solo iconos, constitucion 6). -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="SideTitle" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}" Margin="2,0,10,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="UpButton" Style="{StaticResource GhostIconButton}" Content="&#xE74A;" Click="OnUpClick" />
                        <Button x:Name="RefreshButton" Style="{StaticResource GhostIconButton}" Content="&#xE72C;" Click="OnRefreshClick" />
                        <Button x:Name="NewFolderButton" Style="{StaticResource GhostIconButton}" Content="&#xE8F4;" Click="OnNewFolderClick" />
                        <Button x:Name="RenameButton" Style="{StaticResource GhostIconButton}" Content="&#xE8AC;" Click="OnRenameClick" />
                        <Button x:Name="DeleteButton" Style="{StaticResource DangerIconButton}" Content="&#xE74D;" Click="OnDeleteClick" />
                        <Button x:Name="TransferButton" Style="{StaticResource IconButton}" Content="&#xE72A;" Click="OnTransferClick" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBox x:Name="PathBox" Style="{StaticResource Field}" Height="30" KeyDown="OnPathKeyDown" Margin="0,0,6,0" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Estado del panel: cuantos elementos, o el error de la ultima operacion. -->
        <Border DockPanel.Dock="Bottom" Padding="8,3" BorderBrush="{DynamicResource Separator}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="PaneStatus" Style="{StaticResource HintText}" FontSize="11" TextTrimming="CharacterEllipsis" />
        </Border>

        <ListView x:Name="List" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                  SelectionMode="Extended" AllowDrop="True"
                  MouseDoubleClick="OnListDoubleClick" KeyDown="OnListKeyDown"
                  PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                  DragOver="OnListDragOver" Drop="OnListDrop">
            <ListView.Resources>
                <Style TargetType="GridViewColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Separator}" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="Padding" Value="6,4" />
                </Style>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                    <Setter Property="Padding" Value="2,3" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <GridViewRowPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PageBackground}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary}" />
                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Width="260">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="SizeColumn" Width="90" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn x:Name="DateColumn" Width="130" DisplayMemberBinding="{Binding DateText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
